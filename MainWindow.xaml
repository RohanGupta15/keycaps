<Window x:Class="ShutdownTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="Shutdown Timer"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Icon="brand/shutdown-timer.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Client area covers the whole window so the Mica backdrop (applied in code)
         shows behind our own title bar and content, like Windows 11 inbox apps. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24,20" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Windows 11 caption button (46x32, square, subtle hover). -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C83C31" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet chevron above/below each time segment (Clock app style). -->
        <Style x:Key="ChevronButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="80" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="56" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="Segment" TargetType="StackPanel">
            <Setter Property="Background" Value="Transparent" />
            <EventSetter Event="MouseWheel" Handler="Segment_MouseWheel" />
        </Style>

        <!-- Repeat day chip (Clock app alarm style) -->
        <Style x:Key="DayChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <EventSetter Event="Click" Handler="Day_Click" />
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- App icon, 16 px small cut (brand/shutdown-timer-symbol-small.svg) as vectors: sharp at any DPI. -->
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Path Fill="#32349A" Data="M3 0.5H13A3 3 0 0 1 16 3.5V12.5A3 3 0 0 1 13 15.5H3A3 3 0 0 1 0 12.5V3.5A3 3 0 0 1 3 0.5Z" />
                        <Path Fill="#6468DC" Data="M3.5 1H12.5A2.5 2.5 0 0 1 15 3.5V9.5A2.5 2.5 0 0 1 12.5 12H3.5A2.5 2.5 0 0 1 1 9.5V3.5A2.5 2.5 0 0 1 3.5 1Z" />
                        <Path Fill="#FFFFFF" Data="M10.89 3.55A4.5 4.5 0 1 1 5.11 3.55A1 1 0 0 1 6.39 5.08A2.5 2.5 0 1 0 9.61 5.08A1 1 0 0 1 10.89 3.55ZM7 3A1 1 0 0 1 9 3V6H10.52A1 1 0 0 1 10.52 8H8A1 1 0 0 1 7 7Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="TitleText" Text="Shutdown Timer" FontSize="12" Margin="12,0,0,1"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, ElementName=Root}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" ToolTip="Settings"
                        AutomationProperties.Name="Settings" Click="Settings_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1" Margin="20,12,20,20">

            <!-- Not scheduled: pick a time -->
            <StackPanel x:Name="IdlePanel">
                <!-- Fluent InfoBar (caution): a shutdown didn't run because the PC was asleep -->
                <Border x:Name="MissedBar" Visibility="Collapsed" Margin="0,0,0,12" Padding="16,12,8,12"
                        CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Grid>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="32" Height="32"
                                VerticalAlignment="Top" Margin="8,-6,0,0" Content="&#xE8BB;" ToolTip="Dismiss"
                                WindowChrome.IsHitTestVisibleInChrome="False" Click="DismissMissed_Click" />
                        <StackPanel>
                            <TextBlock Text="Shutdown skipped" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="MissedText" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Your PC was asleep at 3:00 AM, so it didn't shut down." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Shut down at" Style="{StaticResource SectionLabel}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
                            <StackPanel Style="{StaticResource Segment}" Tag="hour">
                                <RepeatButton Style="{StaticResource ChevronButton}" Content="&#xE70E;" Tag="hour:+1" Click="Step_Click" ToolTip="Later hour" />
                                <TextBlock x:Name="HourText" Style="{StaticResource SegmentText}" Text="03" />
                                <RepeatButton Style="{StaticResource ChevronButton}" Content="&#xE70D;" Tag="hour:-1" Click="Step_Click" ToolTip="Earlier hour" />
                            </StackPanel>

                            <TextBlock Text=":" Style="{StaticResource SegmentText}" VerticalAlignment="Center"
                                       Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <StackPanel Style="{StaticResource Segment}" Tag="minute">
                                <RepeatButton Style="{StaticResource ChevronButton}" Content="&#xE70E;" Tag="minute:+1" Click="Step_Click" ToolTip="Later minute" />
                                <TextBlock x:Name="MinuteText" Style="{StaticResource SegmentText}" Text="00" />
                                <RepeatButton Style="{StaticResource ChevronButton}" Content="&#xE70D;" Tag="minute:-1" Click="Step_Click" ToolTip="Earlier minute" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource Segment}" Tag="ampm" Margin="8,0,0,0">
                                <RepeatButton Style="{StaticResource ChevronButton}" Width="56" Content="&#xE70E;" Tag="ampm:+1" Click="Step_Click" ToolTip="Switch AM/PM" />
                                <TextBlock x:Name="AmPmText" Style="{StaticResource SegmentText}" Text="AM"
                                           FontSize="24" Height="75" Padding="0,36,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <RepeatButton Style="{StaticResource ChevronButton}" Width="56" Content="&#xE70D;" Tag="ampm:-1" Click="Step_Click" ToolTip="Switch AM/PM" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Today · in 1h 05m" />

                        <DockPanel Margin="0,20,0,8">
                            <TextBlock Text="Repeat" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="RepeatText" Text="Once" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Tag is the DayOfWeek number. None picked = once. -->
                        <StackPanel x:Name="DayChips" Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton Style="{StaticResource DayChip}" Content="M" Tag="1" ToolTip="Monday" AutomationProperties.Name="Monday" />
                            <ToggleButton Style="{StaticResource DayChip}" Content="T" Tag="2" ToolTip="Tuesday" AutomationProperties.Name="Tuesday" />
                            <ToggleButton Style="{StaticResource DayChip}" Content="W" Tag="3" ToolTip="Wednesday" AutomationProperties.Name="Wednesday" />
                            <ToggleButton Style="{StaticResource DayChip}" Content="T" Tag="4" ToolTip="Thursday" AutomationProperties.Name="Thursday" />
                            <ToggleButton Style="{StaticResource DayChip}" Content="F" Tag="5" ToolTip="Friday" AutomationProperties.Name="Friday" />
                            <ToggleButton Style="{StaticResource DayChip}" Content="S" Tag="6" ToolTip="Saturday" AutomationProperties.Name="Saturday" />
                            <ToggleButton Style="{StaticResource DayChip}" Content="S" Tag="0" ToolTip="Sunday" AutomationProperties.Name="Sunday" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Quick set" Style="{StaticResource Caption}" Margin="4,16,0,8" />
                <UniformGrid Columns="3" Margin="-4,0">
                    <Button Style="{StaticResource PresetButton}" Content="In 30 min" Tag="30" Click="Preset_Click" />
                    <Button Style="{StaticResource PresetButton}" Content="In 1 hour" Tag="60" Click="Preset_Click" />
                    <Button Style="{StaticResource PresetButton}" Content="In 2 hours" Tag="120" Click="Preset_Click" />
                </UniformGrid>

                <Button x:Name="ScheduleButton" Style="{DynamicResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Height="40" Margin="0,20,0,0"
                        IsDefault="True" Click="Schedule_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,1,10,0" />
                        <TextBlock Text="Schedule shutdown" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Honest limitation, in the spirit of the Clock app's "only if the PC is awake" note -->
                <DockPanel Margin="4,14,4,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Margin="0,2,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Your PC has to be awake to shut down. Shutdown Timer keeps it awake while it's plugged in, but closing the lid or choosing Sleep will delay the shutdown." />
                </DockPanel>
            </StackPanel>

            <!-- Scheduled: countdown ring -->
            <StackPanel x:Name="ScheduledPanel" Visibility="Collapsed">
                <Border x:Name="WarningBar" Visibility="Collapsed" Margin="0,0,0,12" Padding="16,12,12,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Shutting down soon" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,8"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button Content="Snooze 15 min" HorizontalAlignment="Left" Click="Snooze_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="24,20,24,28">
                    <StackPanel>
                        <TextBlock x:Name="ScheduledTitle" Text="Shutdown scheduled" Style="{StaticResource SectionLabel}" />

                        <Grid Width="232" Height="232" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.35"
                                     StrokeThickness="8" />
                            <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                  StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="CountdownText" Text="1:05:12"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="TargetText" Text="3:45 AM · Today" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Keep-awake status: plugged in / on battery / late shutdown after sleep -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock x:Name="AwakeIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AwakeText" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Keeping your PC awake until then" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fluent InfoBar (caution) -->
                <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Save your work" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Open apps will close without asking. Closing this window keeps Shutdown Timer in the tray so it can keep your PC awake." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border x:Name="AutoStartBar" Visibility="Collapsed" Margin="0,12,0,0" Padding="16,12,12,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Turn on Start with Windows" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,2,0,8"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="After each shutdown, Shutdown Timer has to start with Windows to set up the next one." />
                            <Button Content="Turn on" HorizontalAlignment="Left" Click="TurnOnAutoStart_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Rows="1" Margin="-4,20,-4,0">
                    <Button x:Name="SkipButton" Content="Skip this one" Height="40" FontSize="14" Margin="4,0"
                            Visibility="Collapsed" Click="Skip_Click" />
                    <Button Content="Cancel shutdown" Height="40" FontSize="14" Margin="4,0" Click="Cancel_Click" />
                </UniformGrid>
            </StackPanel>

            <!-- Settings (PowerToys-style cards). Changes apply right away. -->
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left" Style="{StaticResource CaptionButton}" Width="32" Height="32"
                            Content="&#xE72B;" ToolTip="Back" AutomationProperties.Name="Back" Focusable="True"
                            WindowChrome.IsHitTestVisibleInChrome="False" Click="Back_Click" />
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                               Margin="8,0,0,2" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>

                <TextBlock Text="General" Style="{StaticResource SectionLabel}" Margin="4,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <DockPanel>
                        <CheckBox x:Name="AutoStartCheck" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="Start with Windows" Click="AutoStartCheck_Click" />
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="AutoStartNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Close button" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                                   Text="With a shutdown pending it always stays in the tray, to keep your PC awake." />
                        <ComboBox x:Name="CloseCombo" AutomationProperties.Name="Close button"
                                  SelectionChanged="CloseCombo_SelectionChanged">
                            <ComboBoxItem Content="Keep running in the tray" />
                            <ComboBoxItem Content="Quit when nothing is scheduled" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="Shutdown" Style="{StaticResource SectionLabel}" Margin="4,16,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Warn before shutdown" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                                   Text="The window pops up with Snooze 15 min." />
                        <!-- Order matches Settings.WarnChoices -->
                        <ComboBox x:Name="WarnCombo" AutomationProperties.Name="Warn before shutdown"
                                  SelectionChanged="WarnCombo_SelectionChanged">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="1 minute before" />
                            <ComboBoxItem Content="5 minutes before" />
                            <ComboBoxItem Content="10 minutes before" />
                            <ComboBoxItem Content="15 minutes before" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionLabel}" Margin="4,16,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Hyperlink Click="GitHub_Click">GitHub</Hyperlink>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="Shutdown Timer" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
