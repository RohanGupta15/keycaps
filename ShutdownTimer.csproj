<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ThemeMode (Fluent theme + Mica backdrop) is marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>brand\shutdown-timer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="brand\shutdown-timer.ico" />
  </ItemGroup>

</Project>
